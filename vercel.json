{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/particle",
      "destination": "/particle/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/particle/:path*",
      "destination": "https://every-last-particle.vercel.app/particle/:path*"
    }
  ]
}
