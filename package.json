{
  "name": "every-last-joule-dashboard",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "observable preview",
    "prebuild": "rm -rf src/.observablehq/cache",
    "build": "observable build",
    "deploy": "observable deploy",
    "test": "vitest run",
    "version-history": "tsx scripts/build-version-history.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-snapshots.ts",
    "snapshot:stamp-provenance": "tsx scripts/migrate-snapshot-provenance.ts",
    "tally:tiers": "tsx scripts/tally-tiers.ts",
    "ci:tier-coherence": "tsx scripts/ci/check-tier-coherence.ts",
    "ci:source-provenance-coherence": "tsx scripts/ci/check-source-provenance-coherence.ts",
    "ci:source-provenance-self-test": "tsx scripts/ci/check-source-provenance-coherence.ts --self-test",
    "ci:tally-golden": "tsx scripts/ci/check-tally-golden.ts",
    "ci:docs-drift": "tsx scripts/ci/check-docs-drift.ts",
    "ci:bad-conversions-stub": "tsx scripts/ci/check-validation-doc-bad-conversions.ts",
    "ci:magnitude-golden": "tsx scripts/ci/check-magnitude-golden.ts",
    "ci:magnitude-self-test": "tsx scripts/ci/check-magnitude-golden.ts --self-test",
    "ci:gates": "npm run ci:tier-coherence && npm run ci:source-provenance-coherence && npm run ci:source-provenance-self-test && npm run ci:tally-golden && npm run ci:magnitude-self-test && npm run ci:magnitude-golden && npm run ci:docs-drift && npm run ci:bad-conversions-stub",
    "lint:coverage-audit": "python3 scripts/validation/lint_coverage_audit.py data/coverage-audit/2026-04-26-world.csv data/coverage-audit/2026-06-10-granularity-and-gaps.csv",
    "test:coverage-audit": "python3 -m pytest scripts/validation/test_coverage_audit_schema.py scripts/validation/test_lint_coverage_audit.py scripts/validation/test_merge_coverage_audit.py -v",
    "data:refresh": "observable build",
    "snapshot": "tsx scripts/write-snapshot.ts",
    "reproduce:ercot-west": "python3 scripts/reproduce/reproduce_2024_ercot_west.py",
    "postinstall": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@observablehq/framework": "^1.13.0",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.7.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^20.14.0",
    "@types/topojson-client": "^3.1.4",
    "jsdom": "^24.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
