# .env.example — copy to .env.local and fill in your own values.
#
#   cp .env.example .env.local   # then edit .env.local
#
# .env.local is gitignored and MUST NEVER be committed. Do not paste real
# secrets into this file — the placeholders below are intentional.
#
# The build works WITHOUT any of these: every loader wraps its fetch in
# src/lib/resilient.ts::withFallback and serves the last-good snapshot from
# data/snapshots/last-good/. Tokens only enable LIVE refresh.

# --- EIA Open Data — free, read-only public data (low-impact if leaked) ---
# Register (key emailed instantly): https://www.eia.gov/opendata/register.php
EIA_API_KEY=REDACTED

# --- ENTSO-E Transparency Platform — free, read-only public data ---
# Account → Settings → "Web Api Security Token": https://transparency.entsoe.eu/
ENTSOE_API_TOKEN=REDACTED

# --- ERCOT Public API — a real account login. Treat as sensitive. ---
# Portal: https://apiexplorer.ercot.com/  (register an account; rotate the
# password and regenerate the subscription key from the developer portal)
ERCOT_API_KEY=REDACTED
ERCOT_USERNAME=REDACTED
ERCOT_PASSWORD=REDACTED
ERCOT_PRODUCT_ID=REDACTED

# --- Not used by the dashboard build (kept for reference) ---
# DEEPSEEK_API_KEY — paid LLM API; only ad-hoc research scripts use it, not the build.
# ELEXON_API_KEY — mentioned in README historically; no current loader reads it.
